# Copy to .env and fill in. Never commit .env.
# Create an app at https://developer.spotify.com/dashboard and add this Redirect URI:
#   http://127.0.0.1:8889/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: normally `npm run spotify-auth` saves the token to data/spotify-token.json.
SPOTIFY_REFRESH_TOKEN=

# Host port for docker compose (the container always listens on 8080).
PORT=8080

# ---- Lab tab ----
# Name shown on the Mac mini window (default: hostname).
HOST_LABEL=
# Containers that are supposed to be stopped, comma separated (hidden from the list).
DOCKER_IGNORE=
# Shell command that prints the CPU temperature in °C (default: macmon if installed).
TEMP_COMMAND=

# ---- Weather tab (Open-Meteo, no key needed) ----
WEATHER_NAME=
WEATHER_LAT=
WEATHER_LON=
WEATHER_TZ=
